{
  "name": "snippetscopybook",
  "version": "1.1.0",
  "description": "Paragraph and clipboard manager",
  "main": "main.js",
  "bin": "index.js",
  "pkg": {
    "assets": [
      "defaultData.js",
      "index.html",
      "styles.css",
      "main.js",
      "package.json",
      "package-lock.json",
      "README.md",
      "LICENSE",
      "icon.png",
      "preload.js",
      "renderer.js"
    ]
  },
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:win": "electron-builder --win"
  },
  "keywords": [],
  "author": "SebiMonsrud",
  "license": "ISC",
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.sebimonsrud.snippetscopybook",
    "productName": "SnippetsCopyBook",
    "files": [
      "**/*",
      "!EXE",
      "!EXE/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "C.ico"
    }
  }
}